# Copy these into Netlify: Site configuration > Environment variables
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret_for_the_env_below
PLAID_ENV=sandbox            # sandbox while testing, production for your real cards
APP_PASSCODE=pick-a-long-passcode
SYNC_START_DATE=2026-09-01   # nothing earlier than this is pulled
